# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (used by docker-compose and the backend)
POSTGRES_USER=comicseek
POSTGRES_PASSWORD=comicseek
POSTGRES_DB=comicseek
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://comicseek:comicseek@localhost:5432/comicseek

# ComicVine API (https://comicvine.gamespot.com/api/)
COMICVINE_API_KEY=your-key-here
