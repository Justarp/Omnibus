# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (used by docker-compose and the backend)
POSTGRES_USER=omnibus
POSTGRES_PASSWORD=omnibus
POSTGRES_DB=omnibus
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://omnibus:omnibus@localhost:5432/omnibus

# ComicVine API (https://comicvine.gamespot.com/api/)
COMICVINE_API_KEY=your-key-here
